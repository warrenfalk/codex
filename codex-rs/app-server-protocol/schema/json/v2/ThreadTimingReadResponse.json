{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadTimingActiveSpan": {
      "properties": {
        "elapsedUs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "record": {
          "$ref": "#/definitions/ThreadTimingRecord"
        },
        "stream": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadTimingStream"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "elapsedUs",
        "record"
      ],
      "type": "object"
    },
    "ThreadTimingEntry": {
      "properties": {
        "id": {
          "description": "Stable identity in this rollout, suitable for deduplicating a replayed page.",
          "type": "string"
        },
        "record": {
          "$ref": "#/definitions/ThreadTimingRecord"
        }
      },
      "required": [
        "id",
        "record"
      ],
      "type": "object"
    },
    "ThreadTimingEvent": {
      "oneOf": [
        {
          "properties": {
            "at_ms": {
              "format": "int64",
              "type": "integer"
            },
            "model": {
              "type": "string"
            },
            "type": {
              "enum": [
                "started"
              ],
              "title": "StartedThreadTimingEventType",
              "type": "string"
            }
          },
          "required": [
            "at_ms",
            "model",
            "type"
          ],
          "title": "StartedThreadTimingEvent",
          "type": "object"
        },
        {
          "properties": {
            "at_ms": {
              "format": "int64",
              "type": "integer"
            },
            "duration_us": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "response_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/definitions/ThreadTimingStatus"
            },
            "stream": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ThreadTimingStream"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "completed"
              ],
              "title": "CompletedThreadTimingEventType",
              "type": "string"
            }
          },
          "required": [
            "at_ms",
            "duration_us",
            "status",
            "type"
          ],
          "title": "CompletedThreadTimingEvent",
          "type": "object"
        },
        {
          "properties": {
            "at_ms": {
              "format": "int64",
              "type": "integer"
            },
            "boundary": {
              "$ref": "#/definitions/ThreadTimingItemBoundary"
            },
            "item_id": {
              "type": "string"
            },
            "item_type": {
              "type": "string"
            },
            "stream": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ThreadTimingItem"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "item"
              ],
              "title": "ItemThreadTimingEventType",
              "type": "string"
            }
          },
          "required": [
            "at_ms",
            "boundary",
            "item_id",
            "item_type",
            "type"
          ],
          "title": "ItemThreadTimingEvent",
          "type": "object"
        },
        {
          "properties": {
            "at_ms": {
              "format": "int64",
              "type": "integer"
            },
            "response_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "responseCreated"
              ],
              "title": "ResponseCreatedThreadTimingEventType",
              "type": "string"
            }
          },
          "required": [
            "at_ms",
            "response_id",
            "type"
          ],
          "title": "ResponseCreatedThreadTimingEvent",
          "type": "object"
        }
      ]
    },
    "ThreadTimingItem": {
      "properties": {
        "deltaBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "deltaCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "firstDeltaAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "lastDeltaAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "deltaBytes",
        "deltaCount"
      ],
      "type": "object"
    },
    "ThreadTimingItemBoundary": {
      "enum": [
        "added",
        "done"
      ],
      "type": "string"
    },
    "ThreadTimingPhase": {
      "enum": [
        "prepareRequest",
        "samplingAttempt",
        "modelRequest",
        "transportAttempt",
        "streamSetup",
        "modelCatalogRefresh",
        "toolWait",
        "retryRecovery",
        "modelOutput"
      ],
      "type": "string"
    },
    "ThreadTimingRecord": {
      "properties": {
        "attempt": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "event": {
          "$ref": "#/definitions/ThreadTimingEvent"
        },
        "parentSpanId": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/definitions/ThreadTimingPhase"
        },
        "requestId": {
          "type": "string"
        },
        "spanId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        },
        "version": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "attempt",
        "event",
        "phase",
        "requestId",
        "spanId",
        "threadId",
        "turnId",
        "version"
      ],
      "type": "object"
    },
    "ThreadTimingStatus": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ThreadTimingStream": {
      "properties": {
        "deltaBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "deltaCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "eventCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "eventProcessingUs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "firstDeltaAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "firstEventAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "lastDeltaAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "lastEventAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "omittedItemCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "receiveWaitUs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deltaBytes",
        "deltaCount",
        "eventCount",
        "eventProcessingUs",
        "omittedItemCount",
        "receiveWaitUs"
      ],
      "type": "object"
    }
  },
  "properties": {
    "active": {
      "description": "Process-local provisional counters, replaced by durable completions when available.",
      "items": {
        "$ref": "#/definitions/ThreadTimingActiveSpan"
      },
      "type": "array"
    },
    "cursor": {
      "description": "Resume after the scanned prefix, including when data is empty or at EOF.",
      "type": "string"
    },
    "data": {
      "items": {
        "$ref": "#/definitions/ThreadTimingEntry"
      },
      "type": "array"
    },
    "nextCursor": {
      "description": "Continue backfill immediately when present; otherwise wait for new observations.",
      "type": [
        "string",
        "null"
      ]
    },
    "observedAtMs": {
      "format": "int64",
      "type": "integer"
    },
    "skippedRecordCount": {
      "description": "Malformed rollout lines or unsupported timing records encountered in this page.",
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "active",
    "cursor",
    "data",
    "observedAtMs",
    "skippedRecordCount"
  ],
  "title": "ThreadTimingReadResponse",
  "type": "object"
}